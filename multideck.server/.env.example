# Tenant-specific runtime configuration. Copy to multideck.server/.env locally;
# never commit the populated file.
ConnectionStrings__Supabase=
MULTIDECK_CONNECTION=

Supabase__Url=
Supabase__JwtIssuer=
Supabase__JwtAudience=authenticated
Supabase__JwtSecret=
Supabase__ServiceRoleKey=
Supabase__InviteRedirectUrl=

Documents__Supabase__ApiKey=

Intelligence__Endpoint=https://api.openai.com/v1
Intelligence__Model=gpt-5.6-luna
Intelligence__ApiKey=

BetterStack__SourceToken=
BetterStack__Endpoint=

# Inbox API/provider configuration is created separately for every tenant.
Inbox__EnableWorkers=true
Inbox__OAuth__CanonicalStartEndpoint=
Inbox__OAuth__ReturnOrigin=
Inbox__OAuth__ReturnPath=/inbox
Inbox__Google__Enabled=false
Inbox__Google__ClientId=
Inbox__Google__ClientSecret=
Inbox__Google__CallbackUri=
Inbox__Google__PubSubTopicName=
Inbox__Google__PubSubSubscriptionName=
Inbox__Google__WatchRenewalHours=24
Inbox__Microsoft__Enabled=false
Inbox__Microsoft__ClientId=
Inbox__Microsoft__ClientSecret=
Inbox__Microsoft__Tenant=common
Inbox__Microsoft__CallbackUri=
Inbox__Microsoft__WebhookNotificationUrl=
Inbox__Microsoft__SubscriptionLifetimeHours=48
Inbox__Microsoft__RenewBeforeHours=12
Inbox__SubscriptionIntervalSeconds=300
Inbox__OAuthStatePurgeIntervalHours=24
Inbox__Luna__Endpoint=https://api.openai.com/v1/responses
Inbox__Luna__Model=gpt-5.6-luna
Inbox__Luna__ApiKey=

# Tenant Supabase Edge Function secrets. Configure these with `supabase secrets
# set` for the intended tenant project; do not place populated values in this file.
EMAIL_ALLOWED_REDIRECT_ORIGINS=
EMAIL_CANONICAL_APP_ORIGIN=
EMAIL_OAUTH_CALLBACK_URL=
EMAIL_OAUTH_STATE_SIGNING_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
GMAIL_PUBSUB_PUSH_AUDIENCE=
GMAIL_PUBSUB_PUSH_SERVICE_ACCOUNT=
GMAIL_PUBSUB_SUBSCRIPTION=
